{
  "name": "criptografia",
  "version": "1.1.0",
  "private": true,
  "description": "Monorepo com as implementações da cifra FBC em várias linguagens e a suíte de ataques.",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/testar-tudo.mjs",
    "test:bruto": "pnpm -r --no-bail test",
    "fuzz": "node scripts/fuzz-cruzado.mjs",
    "regressao": "node scripts/regressao-historica.mjs",
    "fuzz:memoria": "bash scripts/fuzz-memoria.sh",
    "test:php": "time pnpm --filter @criptografia/php test",
    "test:node": "time pnpm --filter @criptografia/node test",
    "test:python": "time pnpm --filter @criptografia/python test",
    "test:typescript": "time pnpm --filter @criptografia/typescript test",
    "test:bash": "time pnpm --filter @criptografia/bash test",
    "test:java": "time pnpm --filter @criptografia/java test",
    "test:go": "time pnpm --filter @criptografia/go test",
    "test:rust": "time pnpm --filter @criptografia/rust test",
    "test:dart": "time pnpm --filter @criptografia/dart test",
    "test:julia": "time pnpm --filter @criptografia/julia test",
    "typecheck:typescript": "pnpm --filter @criptografia/typescript typecheck",
    "versao": "node scripts/bump-versao.mjs",
    "tag": "bash scripts/criar-tag.sh"
  }
}
