{
    "name": "cfernandes/criptografia",
    "description": "Biblioteca PHP de criptografia",
    "type": "library",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Application\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Application\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "suite": "php bin/executar_testes.php",
        "test": "php bin/runTest.php"
    },
    "authors": [
        {
            "name": "Caio Fernandes",
            "email": "caio.alberto.fernandes@hotmail.com"
        }
    ],
    "version": "1.0.0"
}
